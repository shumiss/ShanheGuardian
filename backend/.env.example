# High-security values belong in backend/.env and must never be committed.
AMAP_WEB_SERVICE_KEY=
AMAP_WEB_SERVICE_SECRET=

# Optional authorized scenic ticket-gate, turnstile, camera, or telecom feed.
# Expected response: { "provider": "...", "sites": [{ "id": "...", "name": "...", "currentVisitors": 0, "capacity": 0, "updatedAt": "..." }] }
CROWD_FLOW_API_URL=
CROWD_FLOW_API_TOKEN=
CROWD_FLOW_PROVIDER=

# MindIE/vLLM OpenAI-compatible chat completions endpoint.
ASCEND_INFERENCE_URL=
ASCEND_API_KEY=
ASCEND_MODEL=qianxing-guardian
ASCEND_TIMEOUT_MS=20000

# Optional. Defaults to backend/data/runtime_incidents.json.
INCIDENT_STORE_PATH=
